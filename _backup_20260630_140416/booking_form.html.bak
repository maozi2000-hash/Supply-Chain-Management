{# 订舱新增/编辑表单 — 粘贴识别 + 拖拽模块排序 #}
{% extends "base.html" %}
{% block title %}{% if booking %}编辑订舱记录{% else %}创建订舱记录{% endif %} — 供应商管理系统{% endblock %}
{% block page_title %}{% if booking %}编辑订舱记录{% else %}创建订舱记录{% endif %}{% endblock %}

{% block extra_css %}
<style>
/* ---- 拖拽模块 ---- */
.module-list { display: flex; flex-direction: column; gap: 12px; }
.module-card {
  background: var(--bg-card); border: 1px solid var(--border-color);
  border-radius: var(--radius); padding: 16px 20px;
  cursor: grab; transition: box-shadow 0.2s, border-color 0.2s;
  position: relative;
}
.module-card:hover { border-color: var(--primary); box-shadow: var(--shadow-sm); }
.module-card.dragging { opacity: 0.5; border-style: dashed; cursor: grabbing; }
.module-card.drag-over { border-color: var(--primary); border-width: 2px; background: var(--primary-light); }
.module-card .drag-handle {
  position: absolute; left: 8px; top: 50%; transform: translateY(-50%);
  color: var(--text-muted); font-size: 16px; letter-spacing: 2px;
  user-select: none; padding: 4px; line-height: 1;
}
.module-card .module-label { font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 8px; }
.module-card .module-label .required { color: var(--danger); }

/* ---- 粘贴区 ---- */
.paste-area { margin-bottom: 20px; }
.paste-area textarea { font-size: 13px; border-radius: var(--radius); resize: vertical; }
.paste-area .btn-parse { margin-top: 8px; }
.parse-result { margin-top: 8px; font-size: 13px; }
.parse-result .badge { margin-right: 4px; }

/* 拖拽时 body 不可选中 */
body.dragging * { user-select: none !important; }
</style>
{% endblock %}

{% block content %}

<div class="card">
  <div class="card-body">

    <!-- ===== 粘贴识别区 ===== -->
    <div class="paste-area">
      <label class="form-label">粘贴船代订舱信息</label>
      <textarea class="form-control" id="pasteInput" rows="5"
                placeholder="将船代发来的订舱信息粘贴到这里，系统自动识别字段&#10;&#10;示例：&#10;航名/航次:OOCL FRANCE/070E&#10;提单号:EGLV143660137161&#10;船公司:EGL长荣&#10;开航日期:2026-06-16&#10;目地港:NEW YORK,NY&#10;截单时间:2026-06-10 12:00"></textarea>
      <button type="button" class="btn btn-outline-primary btn-parse" id="btnParse" onclick="parseBookingText()">
        &#128269; 智能识别填写
      </button>
      <div class="parse-result" id="parseResult"></div>
    </div>

    <!-- ===== 可拖拽模块表单 ===== -->
    <form method="POST"
          action="{% if booking %}{{ url_for('booking.edit_booking', id=booking.id) }}{% else %}{{ url_for('booking.new_booking') }}{% endif %}"
          id="bookingForm">

      <div class="module-list" id="moduleList">
        <!-- 模块由 JS 动态渲染，保证顺序可拖拽 -->
      </div>

      <!-- 隐藏的排序字段 -->
      <input type="hidden" name="module_order" id="moduleOrder" value="">

      <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
          {% if booking %}保存修改{% else %}创建订舱记录{% endif %}
        </button>
        <a href="{{ url_for('booking.list_booking') }}" class="btn btn-outline-secondary">返回列表</a>
      </div>
    </form>

  </div>
</div>

{% endblock %}

{% block extra_js %}
<script>
// ============================================================
// 模块定义 — 顺序即为默认显示顺序
// ============================================================
var MODULE_DEFS = [
  { key: "custom_name",  label: "柜名",             type: "text",     required: false, hint: "客户自定义名称" },
  { key: "vessel_voyage",label: "航名/航次",        type: "text",     required: false, hint: "例如 OOCL FRANCE/070E" },
  { key: "bl_no",        label: "提单号",           type: "text",     required: false, hint: "提单号" },
  { key: "shipping_company", label: "船公司",        type: "text",     required: false, hint: "例如 EGL长荣" },
  { key: "etd",          label: "开航日期 (ETD)",   type: "date",     required: false, hint: "开航日期" },
  { key: "destination",  label: "目地港",           type: "text",     required: false, hint: "例如 NEW YORK,NY" },
  { key: "cutoff_time",  label: "截单时间",         type: "text",     required: false, hint: "例如 2026-06-10 12:00" },
  { key: "order_id",     label: "关联订单",         type: "select",   required: true,  hint: "选择关联订单" },
  { key: "status",       label: "状态",             type: "status",   required: false, hint: "订舱状态" },
  { key: "remarks",      label: "备注",             type: "textarea", required: false, hint: "备注信息" },
];

// 订单选项（从后端传入）
var ORDER_OPTIONS = [
  {% for o in orders %}
  { id: {{ o.id }}, label: "{{ o.order_no }} — {{ o.supplier_name }}{% if o.custom_name %} ({{ o.custom_name }}){% endif %} [{{ o.status }}]" }{% if not loop.last %},{% endif %}
  {% endfor %}
];

// 当前编辑数据（编辑时）
var EDIT_DATA = {% if booking %}{
  custom_name: "{{ booking.custom_name or '' }}",
  vessel_voyage: "{{ booking.vessel_voyage or '' }}",
  bl_no: "{{ booking.bl_no or '' }}",
  shipping_company: "{{ booking.shipping_company or '' }}",
  etd: "{{ booking.etd.strftime('%Y-%m-%d') if booking.etd else '' }}",
  destination: "{{ booking.destination or '' }}",
  cutoff_time: "{{ booking.cutoff_time or '' }}",
  order_id: "{{ booking.order_id or '' }}",
  status: "{{ booking.status or '待订舱' }}",
  remarks: "{{ booking.remarks or '' }}"
}{% else %}{
  status: "待订舱"
}{% endif %};

var SELECTED_ORDER_ID = "{{ selected_order_id }}";

// ============================================================
// 初始化
// ============================================================
var currentOrder = loadModuleOrder();

document.addEventListener("DOMContentLoaded", function () {
  renderModules(currentOrder);
});

// ============================================================
// 加载/保存模块顺序（localStorage 全局共享）
// ============================================================
function loadModuleOrder() {
  try {
    var saved = localStorage.getItem("booking_module_order");
    if (saved) {
      var arr = JSON.parse(saved);
      // 验证是否包含所有 key
      var allKeys = MODULE_DEFS.map(function(d) { return d.key; });
      var savedKeys = arr.map(function(d) { return d.key; });
      if (allKeys.every(function(k) { return savedKeys.indexOf(k) !== -1; })) {
        return arr.map(function(item) {
          var def = MODULE_DEFS.find(function(d) { return d.key === item.key; });
          return def || item;
        });
      }
    }
  } catch(e) {}
  return MODULE_DEFS.slice();
}

function saveModuleOrder(order) {
  try {
    localStorage.setItem("booking_module_order", JSON.stringify(order.map(function(d) { return { key: d.key, label: d.label }; })));
  } catch(e) {}
}

// ============================================================
// 渲染模块
// ============================================================
function renderModules(order) {
  var container = document.getElementById("moduleList");
  if (!container) return;
  container.innerHTML = "";

  order.forEach(function(def, idx) {
    var card = document.createElement("div");
    card.className = "module-card";
    card.setAttribute("draggable", "true");
    card.setAttribute("data-key", def.key);
    card.setAttribute("data-idx", idx);

    // 拖拽事件
    card.addEventListener("dragstart", onDragStart);
    card.addEventListener("dragover", onDragOver);
    card.addEventListener("dragleave", onDragLeave);
    card.addEventListener("drop", onDrop);
    card.addEventListener("dragend", onDragEnd);

    // 长按触发拖拽（移动端）
    var longPressTimer;
    card.addEventListener("touchstart", function(e) {
      longPressTimer = setTimeout(function() {
        card.setAttribute("draggable", "true");
        // 手动触发 dragstart 在移动端比较困难，用简单方式：高亮提示
        card.classList.add("dragging");
        setTimeout(function() { card.classList.remove("dragging"); }, 600);
      }, 500);
    });
    card.addEventListener("touchend", function() { clearTimeout(longPressTimer); });
    card.addEventListener("touchmove", function() { clearTimeout(longPressTimer); });

    // 拖拽手柄
    var handle = document.createElement("span");
    handle.className = "drag-handle";
    handle.innerHTML = "&#x2630;&#x2630;";
    card.appendChild(handle);

    // 标签
    var label = document.createElement("div");
    label.className = "module-label";
    label.innerHTML = def.label + (def.required ? '<span class="required">*</span>' : '');
    card.appendChild(label);

    // 表单控件
    var val = EDIT_DATA[def.key] !== undefined ? EDIT_DATA[def.key] : "";
    if (def.key === "order_id") {
      var sel = document.createElement("select");
      sel.className = "form-select";
      sel.name = "order_id";
      sel.id = "field_order_id";
      sel.innerHTML = '<option value="">— 请选择订单 —</option>';
      ORDER_OPTIONS.forEach(function(o) {
        var selected = (String(val) === String(o.id)) ? " selected" : "";
        if (!val && SELECTED_ORDER_ID && String(o.id) === String(SELECTED_ORDER_ID)) {
          selected = " selected";
        }
        sel.innerHTML += '<option value="' + o.id + '"' + selected + '>' + o.label + '</option>';
      });
      card.appendChild(sel);
    } else if (def.key === "status") {
      var sel2 = document.createElement("select");
      sel2.className = "form-select";
      sel2.name = "status";
      sel2.id = "field_status";
      ["待订舱", "已订舱", "已出运"].forEach(function(s) {
        sel2.innerHTML += '<option value="' + s + '"' + (val === s ? " selected" : "") + '>' + s + '</option>';
      });
      card.appendChild(sel2);
    } else if (def.type === "textarea") {
      var ta = document.createElement("textarea");
      ta.className = "form-control";
      ta.name = def.key;
      ta.id = "field_" + def.key;
      ta.rows = 3;
      ta.value = val;
      card.appendChild(ta);
    } else {
      var inp = document.createElement("input");
      inp.type = def.type;
      inp.className = "form-control";
      inp.name = def.key;
      inp.id = "field_" + def.key;
      inp.placeholder = def.hint;
      inp.value = val;
      card.appendChild(inp);
    }

    container.appendChild(card);
  });
}

// ============================================================
// 拖拽逻辑
// ============================================================
var draggedIdx = -1;

function onDragStart(e) {
  draggedIdx = parseInt(this.getAttribute("data-idx"));
  this.classList.add("dragging");
  document.body.classList.add("dragging");
  e.dataTransfer.effectAllowed = "move";
  e.dataTransfer.setData("text/plain", this.getAttribute("data-key"));
}

function onDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = "move";
  this.classList.add("drag-over");
}

function onDragLeave(e) {
  this.classList.remove("drag-over");
}

function onDrop(e) {
  e.preventDefault();
  this.classList.remove("drag-over");
  var targetIdx = parseInt(this.getAttribute("data-idx"));
  if (draggedIdx === targetIdx) return;

  // 交换位置
  var item = currentOrder.splice(draggedIdx, 1)[0];
  currentOrder.splice(targetIdx, 0, item);
  saveModuleOrder(currentOrder);
  renderModules(currentOrder);
}

function onDragEnd(e) {
  this.classList.remove("dragging");
  document.body.classList.remove("dragging");
  document.querySelectorAll(".module-card").forEach(function(c) {
    c.classList.remove("drag-over");
  });
}

// ============================================================
// 粘贴解析
// ============================================================
function parseBookingText() {
  var text = document.getElementById("pasteInput").value;
  var result = document.getElementById("parseResult");
  if (!text.trim()) {
    result.innerHTML = '<span class="text-warning">请先粘贴订舱信息</span>';
    return;
  }

  var patterns = {
    vessel_voyage:   /航名\/航次\s*[:：]\s*(.+)/i,
    bl_no:           /提单号\s*[:：]\s*(.+)/i,
    shipping_company:/船公司\s*[:：]\s*(.+)/i,
    etd:             /开航日期\s*[:：]\s*(.+)/i,
    destination:     /目地港\s*[:：]\s*(.+)/i,
    cutoff_time:     /截单时间\s*[:：]\s*(.+)/i,
  };

  var found = [];

  for (var key in patterns) {
    var m = text.match(patterns[key]);
    if (m) {
      var val = m[1].trim();
      // 开航日期格式转换
      if (key === "etd") {
        // 尝试匹配 YYYY-MM-DD 或 YYYY/MM/DD
        var dm = val.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
        if (dm) {
          val = dm[1] + "-" + dm[2].padStart(2, "0") + "-" + dm[3].padStart(2, "0");
        }
      }
      // 填入对应字段
      var field = document.getElementById("field_" + key);
      if (field) {
        field.value = val;
      }
      found.push(MODULE_DEFS.find(function(d) { return d.key === key; }).label + ": " + val);
    }
  }

  if (found.length > 0) {
    result.innerHTML = '<span class="text-success">已识别 ' + found.length + ' 个字段：</span><br>' +
      found.map(function(f) { return '<span class="badge bg-success me-1">' + f + '</span>'; }).join(" ");
  } else {
    result.innerHTML = '<span class="text-warning">未识别到任何字段，请检查格式</span>';
  }
}
</script>
{% endblock %}
