{# 订单列表页 #}
{% extends "base.html" %}
{% block title %}订单管理 — 供应商管理系统{% endblock %}
{% block page_title %}订单管理{% endblock %}

{% block content %}

<!-- 搜索与筛选 -->
<div class="card mb-3">
  <div class="card-body">
    <form method="GET" action="{{ url_for('orders.list_orders') }}" class="search-bar">
      <input type="text" name="keyword" class="form-control" placeholder="搜索订单号或客户名..."
             value="{{ keyword or '' }}">
      <select name="status" class="form-select">
        <option value="">全部状态</option>
        {% for opt_value, opt_label in status_options %}
        <option value="{{ opt_value }}" {% if current_status == opt_value %}selected{% endif %}>{{ opt_label }}</option>
        {% endfor %}
      </select>
      <button type="submit" class="btn btn-primary">搜索</button>
      <a href="{{ url_for('orders.list_orders') }}" class="btn btn-outline-secondary">重置</a>
      <div class="ms-auto d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('batchImportModal').classList.add('show');document.body.classList.add('modal-open');">📥 批量导入</button>
        <a id="btnExportSelected" href="javascript:void(0);" onclick="exportSelectedOrders();" class="btn btn-outline-success disabled" aria-disabled="true">📤 导出所选</a>
        <a href="{{ url_for('orders.new_order') }}" class="btn btn-success">+ 新增订单</a>
      </div>
    </form>
  </div>
</div>

<!-- 订单表格 -->
<div class="card">
  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr>
          <th style="width:32px;"><input type="checkbox" id="chkAll" onclick="var cbs=document.querySelectorAll('.chk-ord'); cbs.forEach(function(c){c.checked=document.getElementById('chkAll').checked;}); document.dispatchEvent(new Event('chkchange'));" style="cursor:pointer;"></th>
          <th>订单号</th>
          <th>供应商名称</th>
          <th>柜名</th>
          <th>状态</th>
          <th>创建时间</th>
          <th class="actions">操作</th>
        </tr>
      </thead>
      <tbody>
        {% if orders %}
          {% for order in orders %}
          <tr>
            <td><input type="checkbox" class="chk-ord" value="{{ order.id }}" onclick="document.dispatchEvent(new Event('chkchange'));" style="cursor:pointer;"></td>
            <td>
              <a href="{{ url_for('orders.order_detail', id=order.id) }}">{{ order.order_no }}</a>
            </td>
            <td>{{ order.supplier_name }}</td>
            <td>{{ order.custom_name or '-' }}</td>
            <td><span class="badge badge-status status-{{ order.status }}">{{ order.status }}</span></td>
            <td class="text-muted">{{ order.created_at.strftime('%Y-%m-%d %H:%M') if order.created_at else '' }}</td>
            <td class="actions">
              <a href="{{ url_for('orders.order_detail', id=order.id) }}" class="btn btn-sm btn-outline-secondary">详情</a>
              <a href="{{ url_for('orders.edit_order', id=order.id) }}" class="btn btn-sm btn-outline-primary">编辑</a>
              <form method="POST" action="{{ url_for('orders.delete_order', id=order.id) }}" style="display:inline;"
                    onsubmit="return confirm('确定要删除订单 {{ order.order_no }} 吗？\n删除后关联的生产、订舱、装柜数据也将一并删除。');">
                <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
              </form>
            </td>
          </tr>
          {% endfor %}
        {% else %}
          <tr><td colspan="8">
            <div class="empty-state">
              <div class="empty-icon">📃</div>
              <p>{% if keyword or current_status %}没有找到匹配的订单{% else %}暂无订单数据{% endif %}</p>
              {% if not keyword and not current_status %}
              <a href="{{ url_for('orders.new_order') }}" class="btn btn-primary">创建第一条订单</a>
              {% endif %}
            </div>
          </td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>

  <!-- 分页 -->
  {% if pagination and pagination.pages > 1 %}
  <div class="card-footer d-flex justify-content-between align-items-center">
    <span class="text-muted">共 {{ pagination.total }} 条记录</span>
    <nav>
      <ul class="pagination mb-0">
        {% if pagination.has_prev %}
        <li class="page-item"><a class="page-link" href="{{ url_for('orders.list_orders', page=pagination.prev_num, keyword=keyword, status=current_status) }}">上一页</a></li>
        {% endif %}
        {% for p in pagination.iter_pages() %}
          {% if p %}
          <li class="page-item {% if p == pagination.page %}active{% endif %}">
            <a class="page-link" href="{{ url_for('orders.list_orders', page=p, keyword=keyword, status=current_status) }}">{{ p }}</a>
          </li>
          {% else %}
          <li class="page-item disabled"><span class="page-link">...</span></li>
          {% endif %}
        {% endfor %}
        {% if pagination.has_next %}
        <li class="page-item"><a class="page-link" href="{{ url_for('orders.list_orders', page=pagination.next_num, keyword=keyword, status=current_status) }}">下一页</a></li>
        {% endif %}
      </ul>
    </nav>
  </div>
  {% endif %}
</div>


<!-- 批量导入 模态框 -->
<div class="modal-overlay" id="batchImportModal" onclick="if(event.target===this){this.classList.remove('show');document.body.classList.remove('modal-open');}">
  <div class="modal-box" style="width:560px;max-width:92vw;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0">批量导入订单</h5>
      <button type="button" class="btn-close" onclick="document.getElementById('batchImportModal').classList.remove('show');document.body.classList.remove('modal-open');"></button>
    </div>
    <p class="text-muted small mb-3">
      支持 <code>.xlsx</code> / <code>.xls</code> 文件，一单多行格式。先下载模板、按格式填写后上传，再选择下方策略——上传后可在预览页查看将要创建/跳过的订单。
    </p>
    <form id="batchImportForm" method="POST" action="{{ url_for('orders.batch_import_upload') }}" enctype="multipart/form-data"
          onsubmit="var s=this.querySelector('button[type=submit]'); if(s){s.disabled=true; s.innerText='上传中…';}">
      <div class="upload-zone" onclick="document.getElementById('batchFile').click();"
           style="margin-bottom:14px;">
        <div class="upload-icon">📄</div>
        <p class="mb-1">点击选择 Excel 文件，或拖拽到此处</p>
        <p class="text-muted small mb-0" id="batchFileName">未选择文件</p>
        <input type="file" id="batchFile" name="file" accept=".xlsx,.xls" hidden
               onchange="document.getElementById('batchFileName').textContent = this.files[0] ? this.files[0].name : '未选择文件';">
      </div>

      <fieldset class="mb-3">
        <legend class="form-label">遇到重复订单号的处理策略</legend>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="strategy" id="stratSkip" value="skip" checked>
          <label class="form-check-label" for="stratSkip">
            <strong>跳过重复</strong>（推荐，保留原数据）<br>
            <span class="text-muted small">已存在的订单号会被忽略，被跳过的订单会在预览页显示。</span>
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="strategy" id="stratOverwrite" value="overwrite">
          <label class="form-check-label" for="stratOverwrite">
            <strong>覆盖已有</strong>（删除旧明细、按上传重写）<br>
            <span class="text-muted small">⚠ 会清空原订单的所有 SKU，并按上传的供应商/柜名/状态/备注覆盖。</span>
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="strategy" id="stratAppend" value="append">
          <label class="form-check-label" for="stratAppend">
            <strong>追加明细</strong>（保留原数据、添加新 SKU 行）<br>
            <span class="text-muted small">订单号/供应商/状态保持不变，仅追加新 SKU 行的明细。</span>
          </label>
        </div>
      </fieldset>

      <div class="d-flex justify-content-between gap-2">
        <a href="{{ url_for('orders.batch_template') }}" class="btn btn-outline-secondary">📋 下载模板</a>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-secondary"
                  onclick="document.getElementById('batchImportModal').classList.remove('show');document.body.classList.remove('modal-open');">取消</button>
          <button type="submit" class="btn btn-primary">上传并预览</button>
        </div>
      </div>
    </form>
  </div>
</div>

<style>
  .modal-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 1050;
    align-items: center; justify-content: center; padding: 16px;
  }
  .modal-overlay.show { display: flex; }
  body.modal-open { overflow: hidden; }
  .modal-box {
    background: #fff; border-radius: 12px; padding: 28px 24px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.25); max-height: 90vh; overflow-y: auto;
  }
  .btn-close {
    background: none; border: none; font-size: 20px; cursor: pointer; padding: 0 8px;
  }
  fieldset { border: 1px solid var(--border-color); border-radius: 6px; padding: 12px 14px; }
  legend { font-size: 13px; font-weight: 500; padding: 0 6px; }
  a.disabled, a[aria-disabled="true"] { pointer-events: none; opacity: 0.55; }
</style>
{% endblock %}

{% block extra_js %}
<script>
function updateExportBtn() {
  var n = document.querySelectorAll('.chk-ord:checked').length;
  var btn = document.getElementById('btnExportSelected');
  if (!btn) return;
  if (n === 0) {
    btn.classList.add('disabled');
    btn.setAttribute('aria-disabled', 'true');
    btn.innerHTML = '📤 导出所选';
  } else {
    btn.classList.remove('disabled');
    btn.removeAttribute('aria-disabled');
    btn.innerHTML = '📤 导出所选（' + n + '）';
  }
}
function exportSelectedOrders() {
  var ids = Array.from(document.querySelectorAll('.chk-ord:checked')).map(function(c){return c.value;});
  if (ids.length === 0) { alert('请先勾选要导出的订单'); return; }
  window.location.href = "{{ url_for('orders.batch_export') }}?ids=" + ids.join(',');
}
document.addEventListener('chkchange', updateExportBtn);
</script>
{% endblock %}