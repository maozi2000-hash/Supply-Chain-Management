# ============================================================
# 辅助：保存明细
# ============================================================
def _save_items(order, items_json):
    """解析 JSON 格式的明细数据，覆盖替换保存"""
    import json
    try:
        data = json.loads(items_json)
    except (json.JSONDecodeError, TypeError):
        data = []

    # 删除旧明细
    OrderItem.query.filter_by(order_id=order.id).delete()

    # 插入新明细
    for item_data in data:
        sku = item_data.get("sku", "").strip()
        warehouse = item_data.get("warehouse", "").strip()
        quantity = item_data.get("quantity", 0)
        if sku:
            db.session.add(OrderItem(
                order_id=order.id,
                sku=sku,
                warehouse=warehouse,
                quantity=quantity,
            ))


# ============================================================


# ============================================================
# 批量导入 / 导出 / 模板（多订单 + 多明细）
# ============================================================
# 流程：
#   (1) GET  /orders/batch-template         下载模板（带示例 + 使用说明）
#   (2) POST /orders/batch-import-upload    上传 Excel → 解析 → 暂存到 BATCH_TMP_DIR/<token>.xlsx → 重定向到预览页
#   (3) GET  /orders/batch-import-preview   读回临时文件，重新解析，渲染"将创建 / 将跳过"预览表（含策略）
#   (4) POST /orders/batch-import-confirm   用户确认写入；strategy ∈ {skip, overwrite, append}
#   (5) GET  /orders/batch-export?keyword=&status=   按筛选导出（一单多行，对称导入）
#   (6) GET  /orders/batch-export?ids=1,2,3          按勾选 ID 导出
# ============================================================

BATCH_TEMPLATE_COLUMNS = [
    "订单号",       # 必填；同一订单号多行 = 该订单有多个 SKU 明细
    "供应商名称",   # 必填
    "柜名",         # 可选
    "订单状态",     # 可选；不在 ALL_STATUS_VALUES 中则默认 "下单"
    "备注",         # 可选
    "SKU",          # 必填（明细行）；无 SKU 的行会被跳过
    "仓库",         # 可选（明细行）
    "数量",         # 必填，整数（明细行）
]

STRATEGIES = (
    ("skip", "跳过重复（推荐，保留原数据）"),
    ("overwrite", "覆盖已有（重写明细与状态）"),
    ("append", "追加明细（保留原数据，加 SKU 行）"),
)


def _batch_parse_excel(file_or_path):
    """解析 Excel 到 OrderedDict:
    return {
      "order_no": {
          "meta": {"supplier_name":..., "custom_name":..., "status":..., "remarks":...},
          "items": [(sku, warehouse, quantity), ...],
          "lines": [src_line_no, ...],
      }, ...
    }
    同时返回 line_errors 与 file_meta
    """
    if hasattr(file_or_path, "read"):
        wb = load_workbook(file_or_path, read_only=True)
    else:
        wb = load_workbook(file_or_path, read_only=True)
    ws = wb.active
    rows = list(ws.iter_rows(min_row=2, values_only=True))

    grouped = OrderedDict()
    line_errors = []

    for i, row in enumerate(rows, start=2):
        if not row or not any(row):
            continue
        order_no = str(row[0]).strip() if len(row) > 0 and row[0] is not None else ""
        supplier = str(row[1]).strip() if len(row) > 1 and row[1] is not None else ""
        custom   = str(row[2]).strip() if len(row) > 2 and row[2] is not None else ""
        status   = str(row[3]).strip() if len(row) > 3 and row[3] is not None else ""
        remarks  = str(row[4]).strip() if len(row) > 4 and row[4] is not None else ""
        sku      = str(row[5]).strip() if len(row) > 5 and row[5] is not None else ""
        warehouse= str(row[6]).strip() if len(row) > 6 and row[6] is not None else ""
        qty_raw  = row[7] if len(row) > 7 else None

        if not order_no:
            line_errors.append((i, "订单号为空，已跳过"))
            continue
        if not supplier:
            line_errors.append((i, f"订单 {order_no} 供应商为空，已跳过"))
            continue

        try:
            quantity = int(qty_raw) if qty_raw not in (None, "") else 0
        except (ValueError, TypeError):
            line_errors.append((i, f"订单 {order_no} 数量格式错误"))
            continue

        grp = grouped.setdefault(order_no, {
            "meta": {"supplier_name": supplier, "custom_name": custom, "status": status or "下单", "remarks": remarks},
            "items": [],
            "lines": [],
        })
        if sku:
            grp["items"].append((sku, warehouse, quantity))
        grp["lines"].append(i)

    return {"grouped": grouped, "line_errors": line_errors}


def _batch_validate_grouped(parsed):
    """校验 status 字段是否合法，返回 (cleaned_grouped, status_warnings)"""
    cleaned = OrderedDict()
    warnings = []
    for order_no, payload in parsed["grouped"].items():
        meta = dict(payload["meta"])
        if meta["status"] not in ALL_STATUS_VALUES:
            warnings.append((payload["lines"][0] if payload["lines"] else 0,
                             f"订单 {order_no} 状态「{meta['status']}」不在允许值，已回退为「下单」"))
            meta["status"] = "下单"
        cleaned[order_no] = {**payload, "meta": meta}
    return {"grouped": cleaned, "warnings": warnings}


def _batch_diff_with_db(parsed, strategy):
    """对比数据库现有订单，返回 plan：
       - to_create: 不在 DB 中、需要新建
       - to_skip: 在 DB 中且 strategy=skip
       - to_overwrite: 在 DB 中且 strategy=overwrite
       - to_append: 在 DB 中且 strategy=append
       entry 含: order_no / meta / items / lines / existing_existing_items_count
       注意：因 Order ORM 的 .items 是 relationship descriptor，模板里应使用 existing_items_count，避免 name collision
    """
    grouped = parsed["grouped"]
    existing = {o.order_no: o for o in Order.query.filter(Order.order_no.in_(list(grouped.keys()))).all()}

    plan = {"to_create": [], "to_skip": [], "to_overwrite": [], "to_append": []}
    for order_no, payload in grouped.items():
        entry = {
            "order_no": order_no,
            "meta": payload["meta"],
            "sku_items": payload["items"],
            "lines": payload["lines"],
        }
        if order_no in existing:
            existing_order = existing[order_no]
            entry["existing_status"] = existing_order.status
            entry["existing_supplier"] = existing_order.supplier_name
            entry["existing_items_count"] = OrderItem.query.filter_by(order_id=existing_order.id).count()
            entry["existing_id"] = existing_order.id
            if strategy == "skip":
                plan["to_skip"].append(entry)
            elif strategy == "overwrite":
                plan["to_overwrite"].append(entry)
            elif strategy == "append":
                plan["to_append"].append(entry)
        else:
            plan["to_create"].append(entry)
    return plan


# ----- (1) 模板 -----
@orders_bp.route("/batch-template")
@login_required
def batch_template():
    wb = Workbook()
    ws = wb.active
    ws.title = "批量导入模板"
    header_font = Font(bold=True, size=12, color="FFFFFF")
    header_fill = PatternFill(start_color="1A73E8", end_color="1A73E8", fill_type="solid")
    for col, h in enumerate(BATCH_TEMPLATE_COLUMNS, 1):
        cell = ws.cell(row=1, column=col, value=h)
        cell.font = header_font
        cell.fill = header_fill
        cell.alignment = Alignment(horizontal="center")
    examples = [
        ("示例订单001", "测试供应商A", "示例柜", "下单", "演示数据", "SKU001", "默认仓库", 100),
        ("示例订单001", "测试供应商A", "示例柜", "下单", "演示数据", "SKU002", "次品仓",     200),
        ("示例订单002", "测试供应商B", "",       "下单", "",        "SKU001", "",           50),
    ]
    for r, row in enumerate(examples, start=2):
        for c, v in enumerate(row, start=1):
            ws.cell(row=r, column=c, value=v)
    widths = [16, 20, 16, 12, 30, 16, 16, 10]
    for i, w in enumerate(widths, 1):
        ws.column_dimensions[get_column_letter(i)].width = w

    ws2 = wb.create_sheet("使用说明")
    notes = [
        ["字段", "必填", "说明"],
        ["订单号", "是", "同一订单号可出现多行，每行表示该订单的一个 SKU 明细"],
        ["供应商名称", "是", ""],
        ["柜名", "否", "客户/柜名"],
        ["订单状态", "否", "留空则默认为「下单」；支持的值：下单 / 生产中 / 生产完成 / 订舱中 / 已订舱 / 装柜完成 / 已取消"],
        ["备注", "否", ""],
        ["SKU", "是(明细行)", "无 SKU 的行会被跳过"],
        ["仓库", "否(明细行)", ""],
        ["数量", "是(明细行)", "整数"],
        ["", "", ""],
        ["重复订单策略", "", "默认「跳过」；也支持「覆盖」「追加」——上传时选定"],
    ]
    for r, row in enumerate(notes, start=1):
        for c, v in enumerate(row, start=1):
            cell = ws2.cell(row=r, column=c, value=v)
            if r == 1:
                cell.font = Font(bold=True)
    ws2.column_dimensions["A"].width = 14
    ws2.column_dimensions["B"].width = 14
    ws2.column_dimensions["C"].width = 80

    output = io.BytesIO()
    wb.save(output)
    output.seek(0)
    from flask import send_file
    return send_file(
        output,
        mimetype="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        as_attachment=True,
        download_name="订单批量导入模板.xlsx",
    )


# ----- (2) 上传 + 解析 + 暂存（不写库） -----
@orders_bp.route("/batch-import-upload", methods=["POST"])
@login_required
def batch_import_upload():
    file = request.files.get("file")
    strategy = (request.form.get("strategy") or "skip").strip()
    if strategy not in dict(STRATEGIES):
        strategy = "skip"

    if not file or not file.filename:
        flash("请选择 Excel 文件", "error")
        return redirect(url_for("orders.list_orders"))
    if not (file.filename.endswith(".xlsx") or file.filename.endswith(".xls")):
        flash("仅支持 .xlsx / .xls 文件", "error")
        return redirect(url_for("orders.list_orders"))

    os.makedirs(_BATCH_TMP, exist_ok=True)
    token = uuid.uuid4().hex
    save_path = os.path.join(_BATCH_TMP, f"{token}.xlsx")
    try:
        file.save(save_path)
    except Exception:
        flash("上传文件保存失败", "error")
        return redirect(url_for("orders.list_orders"))

    # 先快速校验能否解析
    try:
        parsed = _batch_parse_excel(save_path)
    except Exception:
        try: os.remove(save_path)
        except Exception: pass
        flash("Excel 解析失败，请确认格式正确", "error")
        return redirect(url_for("orders.list_orders"))
    if not parsed["grouped"]:
        try: os.remove(save_path)
        except Exception: pass
        flash("Excel 未解析到任何订单行", "error")
        return redirect(url_for("orders.list_orders"))

    return redirect(url_for("orders.batch_import_preview", token=token, strategy=strategy))


# ----- (3) 预览页 -----
@orders_bp.route("/batch-import-preview")
@login_required
def batch_import_preview():
    token = (request.args.get("token") or "").strip()
    strategy = (request.args.get("strategy") or "skip").strip()
    if strategy not in dict(STRATEGIES):
        strategy = "skip"

    save_path = os.path.join(_BATCH_TMP, f"{token}.xlsx")
    if not token or not os.path.isfile(save_path):
        flash("预览数据已失效，请重新上传", "error")
        return redirect(url_for("orders.list_orders"))

    try:
        raw = _batch_parse_excel(save_path)
    except Exception:
        flash("Excel 解析失败", "error")
        return redirect(url_for("orders.list_orders"))
    validated = _batch_validate_grouped(raw)
    plan = _batch_diff_with_db(validated, strategy)

    return render_template(
        "orders/batch_import_preview.html",
        active_menu="orders",
        strategy=strategy,
        strategies=STRATEGIES,
        token=token,
        plan=plan,
        line_errors=raw["line_errors"],
        status_warnings=validated["warnings"],
    )


# ----- (4) 真正写库 -----
@orders_bp.route("/batch-import-confirm", methods=["POST"])
@login_required
def batch_import_confirm():
    token = (request.form.get("token") or "").strip()
    strategy = (request.form.get("strategy") or "skip").strip()
    if strategy not in dict(STRATEGIES):
        strategy = "skip"

    save_path = os.path.join(_BATCH_TMP, f"{token}.xlsx")
    if not token or not os.path.isfile(save_path):
        flash("预览数据已失效，请重新上传", "error")
        return redirect(url_for("orders.list_orders"))

    try:
        raw = _batch_parse_excel(save_path)
    except Exception:
        flash("Excel 解析失败", "error")
        return redirect(url_for("orders.list_orders"))
    validated = _batch_validate_grouped(raw)
    plan = _batch_diff_with_db(validated, strategy)

    n_created = n_overwritten = n_appended = n_skipped = 0
    for entry in plan["to_create"]:
        order = Order(
            order_no=entry["order_no"],
            supplier_name=entry["meta"]["supplier_name"],
            custom_name=entry["meta"]["custom_name"] or None,
            status=entry["meta"]["status"],
            remarks=entry["meta"]["remarks"] or None,
        )
        db.session.add(order)
        db.session.flush()
        for sku, wh, qty in entry["sku_items"]:
            db.session.add(OrderItem(order_id=order.id, sku=sku, warehouse=wh or None, quantity=qty))
        n_created += 1

    for entry in plan["to_overwrite"]:
        order = db.session.get(Order, entry["existing_id"])
        order.supplier_name = entry["meta"]["supplier_name"]
        order.custom_name = entry["meta"]["custom_name"] or None
        order.status = entry["meta"]["status"]
        order.remarks = entry["meta"]["remarks"] or None
        OrderItem.query.filter_by(order_id=order.id).delete()
        db.session.flush()
        for sku, wh, qty in entry["sku_items"]:
            db.session.add(OrderItem(order_id=order.id, sku=sku, warehouse=wh or None, quantity=qty))
        n_overwritten += 1

    for entry in plan["to_append"]:
        order = db.session.get(Order, entry["existing_id"])
        for sku, wh, qty in entry["sku_items"]:
            db.session.add(OrderItem(order_id=order.id, sku=sku, warehouse=wh or None, quantity=qty))
        n_appended += 1

    n_skipped = len(plan["to_skip"])
    db.session.commit()

    msg_parts = []
    if n_created:     msg_parts.append(f"创建 {n_created} 单")
    if n_overwritten: msg_parts.append(f"覆盖 {n_overwritten} 单")
    if n_appended:    msg_parts.append(f"追加明细 {n_appended} 单")
    if n_skipped:     msg_parts.append(f"跳过 {n_skipped} 单")
    msg = "批量导入：" + "，".join(msg_parts) if msg_parts else "批量导入：无可操作数据"
    flash(msg, "success")

    # 删除临时文件
    try: os.remove(save_path)
    except Exception: pass

    return redirect(url_for("orders.list_orders"))


# ----- (5) + (6) 批量导出 -----
@orders_bp.route("/batch-export")
@login_required
def batch_export():
    keyword = request.args.get("keyword", "").strip()
    current_status = request.args.get("status", "").strip()
    ids_param = request.args.get("ids", "").strip()

    query = Order.query
    if ids_param:
        try:
            id_list = [int(x) for x in ids_param.split(",") if x.strip().isdigit()]
        except Exception:
            id_list = []
        if id_list:
            query = query.filter(Order.id.in_(id_list))
    else:
        if keyword:
            query = query.filter(
                db.or_(
                    Order.order_no.contains(keyword),
                    Order.supplier_name.contains(keyword),
                )
            )
        if current_status and current_status in ALL_STATUS_VALUES:
            query = query.filter(Order.status == current_status)

    orders = query.order_by(Order.created_at.desc()).all()

    wb = Workbook()
    ws = wb.active
    ws.title = "订单批量导出"
    header_font = Font(bold=True, size=12, color="FFFFFF")
    header_fill = PatternFill(start_color="1A73E8", end_color="1A73E8", fill_type="solid")
    for col, h in enumerate(BATCH_TEMPLATE_COLUMNS, 1):
        cell = ws.cell(row=1, column=col, value=h)
        cell.font = header_font
        cell.fill = header_fill
        cell.alignment = Alignment(horizontal="center")
    row = 2
    for order in orders:
        items = order.items
        if not items:
            ws.cell(row=row, column=1, value=order.order_no)
            ws.cell(row=row, column=2, value=order.supplier_name)
            ws.cell(row=row, column=3, value=order.custom_name or "")
            ws.cell(row=row, column=4, value=order.status)
            ws.cell(row=row, column=5, value=order.remarks or "")
            ws.cell(row=row, column=6, value="")
            ws.cell(row=row, column=7, value="")
            ws.cell(row=row, column=8, value=0)
            row += 1
        else:
            for it in items:
                ws.cell(row=row, column=1, value=order.order_no)
                ws.cell(row=row, column=2, value=order.supplier_name)
                ws.cell(row=row, column=3, value=order.custom_name or "")
                ws.cell(row=row, column=4, value=order.status)
                ws.cell(row=row, column=5, value=order.remarks or "")
                ws.cell(row=row, column=6, value=it.sku)
                ws.cell(row=row, column=7, value=it.warehouse or "")
                ws.cell(row=row, column=8, value=it.quantity)
                row += 1
    widths = [16, 20, 16, 12, 30, 16, 16, 10]
    for i, w in enumerate(widths, 1):
        ws.column_dimensions[get_column_letter(i)].width = w

    ws2 = wb.create_sheet("导出说明")
    if ids_param:
        scope = f"按勾选 ID 导出（{len(orders)} 单）"
    else:
        scope = f"按筛选条件导出（搜索: {keyword or '（无）'}, 状态: {current_status or '全部'}，共 {len(orders)} 单）"
    notes = [
        ["导出时间", datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")],
        ["导出范围", scope],
        ["订单数", len(orders)],
        ["导出方式", "一单多行：同一订单号下每个 SKU 明细占一行"],
        ["", ""],
        ["提示", "本文件可作为批量导入的输入；如需修改后再次导入，请删除 Sheet「导出说明」"],
    ]
    for r, row_data in enumerate(notes, start=1):
        for c, v in enumerate(row_data, start=1):
            ws2.cell(row=r, column=c, value=v)
    ws2.column_dimensions["A"].width = 14
    ws2.column_dimensions["B"].width = 80

    output = io.BytesIO()
    wb.save(output)
    output.seek(0)
    from flask import send_file
    ts = datetime.datetime.now().strftime("%Y%m%d_%H%M")
    if ids_param:
        fname = f"订单勾选导出_{ts}.xlsx"
    else:
        fname = f"订单批量导出_{ts}.xlsx"
    return send_file(
        output,
        mimetype="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        as_attachment=True,
        download_name=fname,
    )
