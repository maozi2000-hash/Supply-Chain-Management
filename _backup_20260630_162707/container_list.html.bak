{# 装柜记录列表页 #}
{% extends "base.html" %}
{% block title %}装柜管理 — 供应商管理系统{% endblock %}
{% block page_title %}装柜管理{% endblock %}

{% block content %}

<div class="card mb-3">
  <div class="card-body d-flex justify-content-end">
    {% if pending_orders %}
<div class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span>
      <strong>📦 待填装柜的订单</strong>
      <span class="badge bg-warning text-dark ms-2">{{ pending_orders|length }}</span>
    </span>
    {% if pending_orders %}
      <a href="{{ url_for('container.new_container') }}" class="btn btn-success">+ 开始填下一个</a>
    {% endif %}
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr>
          <th>订单号</th>
          <th>供应商</th>
          <th>柜名</th>
          <th>状态</th>
          <th>创建时间</th>
          <th class="actions">操作</th>
        </tr>
      </thead>
      <tbody>
        {% for o in pending_orders %}
        <tr>
          <td><a href="{{ url_for('orders.order_detail', id=o.id) }}">{{ o.order_no }}</a></td>
          <td>{{ o.supplier_name }}</td>
          <td>{{ o.custom_name or '-' }}</td>
          <td><span class="badge badge-status status-{{ o.status }}">{{ o.status }}</span></td>
          <td class="text-muted">{{ o.created_at.strftime('%Y-%m-%d') if o.created_at else '' }}</td>
          <td class="actions">
            <a href="{{ url_for('container.new_container', order_id=o.id) }}" class="btn btn-sm btn-primary">填装柜</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endif %}
<a href="{{ url_for('container.new_container') }}" class="btn btn-success">+ 新增装柜记录</a>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr>
          <th>订单号</th>
          <th>柜号</th>
          <th>装柜日期</th>
          <th>件数</th>
          <th>毛重(KG)</th>
          <th>体积(CBM)</th>
          <th>图片数</th>
          <th class="actions">操作</th>
        </tr>
      </thead>
      <tbody>
        {% if container_records %}
          {% for cr in container_records %}
          <tr>
            <td>
              {% if cr.order %}
              <a href="{{ url_for('orders.order_detail', id=cr.order.id) }}">{{ cr.order.order_no }}</a>
              {% else %}-{% endif %}
            </td>
            <td>{{ cr.container_no }}</td>
            <td>{{ cr.loading_date.strftime('%Y-%m-%d') if cr.loading_date else '' }}</td>
            <td>{{ cr.cargo_count }}</td>
            <td>{{ '%.2f'|format(cr.weight) if cr.weight else '' }}</td>
            <td>{{ '%.2f'|format(cr.volume) if cr.volume else '' }}</td>
            <td>{{ cr.images|length if cr.images else 0 }}</td>
            <td class="actions">
              <a href="{{ url_for('container.container_detail', id=cr.id) }}" class="btn btn-sm btn-outline-secondary">详情</a>
              <a href="{{ url_for('container.new_container', id=cr.id) }}" class="btn btn-sm btn-outline-primary">编辑</a>
              <a href="{{ url_for('container.export_container', id=cr.id) }}" class="btn btn-sm btn-outline-success">导出</a>
              <form method="POST" action="{{ url_for('container.delete_container', id=cr.id) }}" style="display:inline;"
                    onsubmit="return confirm('确定要删除此装柜记录吗？\n关联图片也将一并删除。');">
                <button type="submit" class="btn btn-sm btn-outline-danger">删除</button>
              </form>
            </td>
          </tr>
          {% endfor %}
        {% else %}
          <tr><td colspan="8">
            <div class="empty-state">
              <div class="empty-icon">&#128230;</div>
              <p>暂无装柜记录</p>
              <a href="{{ url_for('container.new_container') }}" class="btn btn-primary">创建第一条装柜记录</a>
            </div>
          </td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</div>

{% endblock %}
